{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "labelqueue",
  "version": "1.0.1",
  "description": "Official stateless MCP server for LabelQueue.com — exact Avery sheet and thermal roll label dimensions, pitch, margins, and browser print-drift diagnostic engine.",
  "homepage": "https://labelqueue.com",
  "repository": "https://github.com/AbigailDavised/labelqueue-mcp",
  "license": "MIT",
  "author": {
    "name": "Abigail Davised",
    "email": "admin@labelqueue.com",
    "url": "https://labelqueue.com"
  },
  "keywords": [
    "avery-labels",
    "barcode-labels",
    "thermal-printing",
    "print-layout",
    "logistics",
    "mcp"
  ],
  "extensions": {
    "com.nousresearch.hermes": {
      "servers": {
        "labelqueue": {
          "trust": "untrusted"
        }
      }
    }
  }
}
